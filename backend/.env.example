# --- App Settings ---
APP_NAME="AI Powered Job Application Agent API"
APP_ENV=development
LOG_LEVEL=INFO

# --- LLM Settings ---
# Format: provider/model-name (e.g., ollama/llama3, openai/gpt-4o, anthropic/claude-3-5-sonnet, gemini/gemini-1.5-flash)

# Option 1: Ollama (Local) - Default
LLM_MODEL=ollama/gemma4:31b-cloud
LLM_BASE_URL=http://localhost:11434

# Option 2: Google Gemini (Cloud) - Comment out Option 1 and uncomment these
# LLM_MODEL=gemini/gemini-1.5-flash
# GOOGLE_API_KEY=your_google_api_key_here

# Option 3: OpenAI (Cloud) - Comment out Option 1 and uncomment these
# LLM_MODEL=openai/gpt-4o
# OPENAI_API_KEY=your_openai_key_here

# --- Pipeline Settings ---
CREW_VERBOSE=true
MIN_RESUME_CHARS=100
MAX_RESUME_CHARS=20000
MIN_JOB_DESCRIPTION_CHARS=100
MAX_JOB_DESCRIPTION_CHARS=20000
MAX_ACHIEVEMENTS_CHARS=4000

# --- Security ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
